ENVIRONMENT=development
STRICT_STARTUP=true
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./app/db/ophagent_pro.db
UPLOAD_DIR=data/runtime/attachments/files
ATTACHMENT_DIR=data/runtime/attachments

# OpenAI-compatible main and multimodal specialist models
AGENT_URL=https://provider.example/v1
AGENT_API_KEY=
AGENT_MODEL=
SUB_AGENT_URL=https://provider.example/v1
SUB_AGENT_API_KEY=
SUB_AGENT_MODEL=
MODEL_MAX_OUTPUT_TOKENS=4096
RUN_MAX_TOKENS=40000

# Embedding and rerank
SILICONFLOW_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=
RERANK_MODEL=
KNOWLEDGE_EMBED_BATCH_SIZE=32
KNOWLEDGE_VECTOR_CANDIDATES=60
KNOWLEDGE_ALLOW_EXPIRED=false
KNOWLEDGE_MIN_RELEVANCE=0.08

# Search (AnySearch primary, Tavily fallback)
ANYSEARCH_URL=
ANYSEARCH_API_KEY=
TAVILY_URL=https://api.tavily.com/search
TAVILY_API_KEY=

# Speech and document parsing
ASR_URL=
ASR_API_KEY=
ASR_MODEL=
TTS_URL=
TTS_API_KEY=
TTS_MODEL=
MINERU_URL=
MINERU_API_KEY=

# Optional tracing
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ophagent-pro
AGENTSCOPE_STUDIO_URL=
AGENTSCOPE_DISABLE_CONSOLE_OUTPUT=true
AGENT_MAX_ITERS=3
AGENT_REASONING_EFFORT=low

# Optional offline evolution controller (never expose the gate secret to candidates)
EVOLUTION_SEALED_TEST_DIR=
EVOLUTION_GATE_SECRET=
EVOLUTION_GATE_SECRET_FILE=data/evolution/gate_secret
ADAPTIVE_HARNESS_ROOT=
EVOLUTION_REQUIRE_HUMAN_APPROVAL=true
EVOLUTION_MIN_FEEDBACK_SAMPLES=3
EVOLUTION_NEGATIVE_RATE_THRESHOLD=0.60
EVOLUTION_POSITIVE_RATE_THRESHOLD=0.60
EVOLUTION_MEMORY_RANKING_BOUND=0.15
EVOLUTION_SKILL_RANKING_BOUND=0.20
EVOLUTION_SKILL_AUTO_SUPPRESS_THRESHOLD=0.90
EVOLUTION_MIN_MEAN_IMPROVEMENT=0.01
EVOLUTION_MAX_SLICE_REGRESSION=0.0
EVOLUTION_MIN_CASES_PER_SLICE=1
